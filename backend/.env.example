# Django
# Generate a strong value with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-long-random-secret-key
# Must be False in production. When False, transport-security headers are enabled
# and placeholder secrets cause startup to fail.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS (comma-separated frontend origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT
# Use a different strong random value than SECRET_KEY.
JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# Admin credentials used by POST /api/admin/login (bootstrap on first run)
ADMIN_EMAIL=admin@studysync.ai
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Default password applied to students registered without an explicit password
DEFAULT_STUDENT_PASSWORD=studysync

# Optional rate-limit overrides (DRF throttling)
# THROTTLE_RATE_ANON=120/hour
# THROTTLE_RATE_USER=1200/hour
# THROTTLE_RATE_LOGIN=10/minute
